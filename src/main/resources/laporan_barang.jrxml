<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="laporan_barang" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <query language="sql"><![CDATA[SELECT * FROM barang]]></query>
    <field name="kode" class="java.lang.String"/>
    <field name="nama" class="java.lang.String"/>
    <field name="kategori" class="java.lang.String"/>
    <field name="harga" class="java.lang.Double"/>
    <field name="stok" class="java.lang.Integer"/>
    <title height="60">
        <element kind="staticText" x="0" y="5" width="555" height="25" fontName="SansSerif" fontSize="14.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[LAPORAN DATA PERSEDIAAN BARANG]]></text>
        </element>
        <element kind="staticText" x="0" y="30" width="555" height="20" fontName="SansSerif" fontSize="10.0" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Rekapitulasi Stok Gudang Terpusat]]></text>
        </element>
    </title>
    <columnHeader height="26">
        <element kind="staticText" mode="Opaque" x="0" y="0" width="75" height="26" backcolor="#E6E6E6" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[KODE]]></text>
            <box><pen lineWidth="1.0"/></box>
        </element>
        <element kind="staticText" mode="Opaque" x="75" y="0" width="190" height="26" backcolor="#E6E6E6" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[NAMA BARANG]]></text>
            <box><pen lineWidth="1.0"/></box>
        </element>
        <element kind="staticText" mode="Opaque" x="265" y="0" width="110" height="26" backcolor="#E6E6E6" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[KATEGORI]]></text>
            <box><pen lineWidth="1.0"/></box>
        </element>
        <element kind="staticText" mode="Opaque" x="375" y="0" width="110" height="26" backcolor="#E6E6E6" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[HARGA (RP)]]></text>
            <box><pen lineWidth="1.0"/></box>
        </element>
        <element kind="staticText" mode="Opaque" x="485" y="0" width="70" height="26" backcolor="#E6E6E6" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[STOK]]></text>
            <box><pen lineWidth="1.0"/></box>
        </element>
    </columnHeader>
    <detail>
        <band height="22">
            <element kind="textField" x="0" y="0" width="75" height="22" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{kode}]]></expression>
                <box><pen lineWidth="1.0"/></box>
            </element>
            <element kind="textField" x="75" y="0" width="190" height="22" vTextAlign="Middle">
                <expression><![CDATA[$F{nama}]]></expression>
                <box leftPadding="5"><pen lineWidth="1.0"/></box>
            </element>
            <element kind="textField" x="265" y="0" width="110" height="22" vTextAlign="Middle">
                <expression><![CDATA[$F{kategori}]]></expression>
                <box leftPadding="5"><pen lineWidth="1.0"/></box>
            </element>
            <element kind="textField" x="375" y="0" width="110" height="22" pattern="#,##0" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[$F{harga}]]></expression>
                <box rightPadding="5"><pen lineWidth="1.0"/></box>
            </element>
            <element kind="textField" x="485" y="0" width="70" height="22" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{stok}]]></expression>
                <box><pen lineWidth="1.0"/></box>
            </element>
        </band>
    </detail>
    <pageFooter height="22">
        <element kind="textField" x="0" y="2" width="150" height="20" pattern="dd/MM/yyyy" vTextAlign="Middle">
            <expression><![CDATA[new java.util.Date()]]></expression>
        </element>
        <element kind="textField" x="455" y="2" width="100" height="20" hTextAlign="Right" vTextAlign="Middle">
            <expression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>